datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  address   String   @id
  role      String
  name      String?
  createdAt DateTime @default(now())
}

model PaymentMetadata {
  id               String   @id
  businessAddress  String
  recipientAddress String
  title            String
  description      String?
  milestoneDesc    String?
  createdAt        DateTime @default(now())
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String
  txHash    String
  state     String
  actor     String
  timestamp DateTime @default(now())
}
