datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  address   String   @id
  role      String
  name      String?
  createdAt DateTime @default(now())
}

model PaymentMetadata {
  id               String   @id
  businessAddress  String
  recipientAddress String
  title            String
  description      String?
  milestoneDesc    String?
  createdAt        DateTime @default(now())
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String
  txHash    String
  state     String
  actor     String
  timestamp DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  userId    String?  // Optional, hashed or raw address depending on privacy choice
  sessionId String?
  metadata  String?  // JSON string
  timestamp DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // info, warn, error, fatal
  context   String   // frontend, backend, blockchain
  message   String
  metadata  String?  // JSON
  timestamp DateTime @default(now())
}

model UserFeedback {
  id        String   @id @default(uuid())
  address   String?  // Optional for anonymity
  rating    Int
  liked     String?
  confused  String?
  bugs      String?
  features  String?
  timestamp DateTime @default(now())
}

model UserOnboarding {
  address      String   @id
  hasConnected Boolean  @default(false)
  hasCreated   Boolean  @default(false)
  hasAccepted  Boolean  @default(false)
  hasReleased  Boolean  @default(false)
  timestamp    DateTime @default(now())
}
