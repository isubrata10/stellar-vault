datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  address   String   @id
  role      String
  name      String?
  createdAt DateTime @default(now())
}

model PaymentMetadata {
  id               String   @id
  businessAddress  String
  recipientAddress String
  title            String
  description      String?
  milestoneDesc    String?
  createdAt        DateTime @default(now())

  @@index([businessAddress])
  @@index([recipientAddress])
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String
  txHash    String
  state     String
  actor     String
  timestamp DateTime @default(now())

  @@index([paymentId])
  @@index([actor])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  userId    String?
  sessionId String?
  metadata  String?
  timestamp DateTime @default(now())

  @@index([eventName])
  @@index([timestamp])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  context   String
  message   String
  metadata  String?
  timestamp DateTime @default(now())

  @@index([level])
  @@index([timestamp])
}

model UserFeedback {
  id        String   @id @default(uuid())
  address   String?
  rating    Int
  liked     String?
  confused  String?
  bugs      String?
  features  String?
  timestamp DateTime @default(now())
}

model UserOnboarding {
  address      String   @id
  hasConnected Boolean  @default(false)
  hasCreated   Boolean  @default(false)
  hasAccepted  Boolean  @default(false)
  hasReleased  Boolean  @default(false)
  timestamp    DateTime @default(now())
}

model UserValidationFeedback {
  id               String   @id @default(uuid())
  address          String?
  confusing        String?
  expected         String?
  liked            String?
  wouldChange      String?
  useAgain         Boolean  @default(true)
  recommend        Boolean  @default(true)
  timestamp        DateTime @default(now())
}
